@inject NavigationManager Nav

<nav class="nav-menu" style="justify-content: space-between;">
    <button class="nav-toggle @(isOpen ? "active" : "")" @onclick="ToggleMenu" aria-label="切換選單"
            aria-expanded="@isOpen">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
    </button>

    <!-- 遮罩：手機側邊選單開啟時顯示 -->
    <div class="nav-overlay @(isOpen ? "show" : "")" @onclick="CloseMenu"></div>

    <AuthorizeView>
        <Authorized Context="authState">
            <div class="nav-links @(isOpen ? "open" : "")">
                <a href="/items/create" @onclick="CloseMenu">項目新增</a>
                <a href="/items/approve" @onclick="CloseMenu">項目認結</a>
                <a href="/items/query" @onclick="CloseMenu">查詢中心</a>
                <AuthorizeView Roles="Admin">
                    <a href="/admin/manage" @onclick="CloseMenu">管理中心</a>
                </AuthorizeView>
                <a href="/rules" @onclick="CloseMenu">規章辦法</a>

                <form method="post" action="/auth/logout" class="inline-form">
                    <AntiforgeryToken />
                    <button type="submit" class="nav-button logout">登出</button>
                </form>
            </div>

            <span class="user-badge">@authState.User.Identity?.Name</span>
        </Authorized>

        <NotAuthorized>
            <div class="nav-links @(isOpen ? "open" : "")">
                <a href="/" @onclick="CloseMenu">登入 / 註冊</a>
                <a href="/rules" @onclick="CloseMenu">規章辦法</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private bool isOpen = false;

    private void ToggleMenu() => isOpen = !isOpen;
    private void CloseMenu() => isOpen = false;

}