@using System.Security.Claims
@using dotCheck.Application.DTOs
@using dotCheck.Application.Services
@using dotCheck.Infrastructure.Mongo
@inject IPaymentBillRepository paymentBillRepo
@inject PayoutBillService payoutBillService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="payout-bill-panel">
    <div class="payout-bill-toolbar">
        <div>
            <h2>撥款單</h2>
            <p class="muted">顯示目前登入使用者的撥款單，可匯出或匯入簽章檔案。</p>
        </div>

        <div class="payout-bill-actions">
            <InputFile OnChange="HandleImportAsync" accept="text/plain,.txt,application/json,.json" />

        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice success">@_message</div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="notice error">@_error</div>
    }

    @if (_loading)
    {
        <Loading />
    }
    else
    {
        
        <div class="filter-card">
            <div>
                <label>時間範圍</label>
                <input type="date" class="input mt-2" @bind="_filterStartDate" />
                <input type="date" class="input mt-2" @bind="_filterEndDate" />
            </div>
            <button class="button primary" @onclick="LoadAsync">查詢</button>
        </div>
        if (_bills.Count == 0)
        {
            <div class="notice">前間內沒有撥款單。</div>
        }
        else
        {
            <div class="payout-bill-list">
                @foreach (var bill in _bills)
                {
                    <article class="payout-bill-card">
                        <div></div>
                        <div class="payout-bill-main">
                            <div class="payout-bill-title-row">
                                <strong>撥款單 @bill.Id</strong>
                                <span class="status confirmed">已簽章</span>
                            </div>

                            <div class="payout-bill-grid">
                                <div>
                                    <span>項目涵蓋時間</span>
                                    <strong>
                                        @bill.StartDate.ToLocalTime().ToString("yyyy-MM-dd")
                                        ~
                                        @bill.EndDate.ToLocalTime().ToString("yyyy-MM-dd")
                                    </strong>
                                </div>

                                <div>
                                    <span>項目數</span>
                                    <div class="d-flex">
                                        <strong class="me-auto">
                                            @bill.ItemCount
                                        </strong>
                                        <button class="button" @onclick="() => ShowPaymentBillDetail(bill.PaymentBillId)">
                                            明細
                                        </button>
                                    </div>
                                </div>

                                <div>
                                    <span>項目總金額</span>
                                    <strong>@bill.ItemTotalAmount.ToString("C0")</strong>
                                </div>

                                <div>
                                    <span>可撥金額</span>
                                    <strong class="money">@bill.PayoutAmount.ToString("C0")</strong>
                                </div>

                                <div>
                                    <span>建立日期</span>
                                    <strong>
                                        @bill.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    </strong>
                                </div>

                                <div>
                                    <span>總使用者數</span>
                                    <strong>@bill.TotalUserCount</strong>
                                </div>
                            </div>
                            <div class="text-end">
                                @if (bill.SignatureStatus == PayoutBillSignStatus.Pending)
                                {
                                    <button type="button" class="btn btn-danger" @onclick="() => SignPayoutBillAsync(bill.Id)">
                                        已收款簽名
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="button primary me-2" @onclick="() => DownloadSelected(bill.Id)">
                                        下載
                                    </button>
                                    <details class="border rounded p-3 mt-3">
                                        <summary class="fw-semibold text-secondary">
                                            已完成簽名
                                        </summary>



                                        <div class="text-start mt-3">
                                            <div class="mb-3">
                                                <div class="text-muted small mb-1">Key ID</div>
                                                <code class="font-monospace">@bill.KeyId</code>
                                            </div>

                                            <div class="mb-3">
                                                <div class="text-muted small mb-1">Hash</div>
                                                <code class="font-monospace text-break">@bill.PayloadHash</code>
                                            </div>

                                            <div>
                                                <div class="text-muted small mb-1">Signature</div>
                                                <textarea class="form-control font-monospace" rows="4"
                                                          readonly>@bill.Signature</textarea>
                                            </div>
                                        </div>
                                    </details>
                                }

                            </div>

                        </div>

                    </article>
                }
            </div>

        }
    }
    <PaymentBillDetailDialog @bind-IsOpen="@_showPaymentBillDetail" PaymentBill="@_selectedPaymentBill" />
</div>

@code {
    private readonly List<PayoutBillDto> _bills = [];
    private readonly HashSet<ObjectId> _selectedIds = [];

    private ObjectId _userId;
    private bool _loading = true;
    private string? _message;
    private string? _error;
    private bool _showPaymentBillDetail;
    private PaymentBillDto _selectedPaymentBill;

    private DateTime _filterStartDate = DateTime.Today.AddMonths(-1);
    private DateTime _filterEndDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        ObjectId.TryParse(
            state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value,
            out _userId);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var bills = await payoutBillService.GetUserPayoutBillsAsync(_userId, _filterStartDate, _filterEndDate);
            _bills.Clear();
            _bills.AddRange(bills);
            _selectedIds.RemoveWhere(id => _bills.All(x => x.Id != id.ToString()));
        }
        catch (Exception ex)
        {
            _bills.Clear();
            _selectedIds.Clear();
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleSelection(string id, ChangeEventArgs args)
    {
        if (!ObjectId.TryParse(id, out var objectId))
            return;

        if (args.Value is bool selected && selected)
            _selectedIds.Add(objectId);
        else
            _selectedIds.Remove(objectId);
    }

    private void DownloadSelected(string payoutId)
    {
        NavigationManager.NavigateTo($"/payout-bills/export?id={payoutId}", forceLoad: true);
    }
    private async Task SignPayoutBillAsync(string payoutBillId)
    {
        try
        {
            await payoutBillService.SignPayoutBillAsync(
               ObjectId.Parse(payoutBillId),
               _userId);

            await LoadAsync();

            _message = "已完成收款簽名。";
        }
        catch (Exception ex)
        {
            _message = $"簽名失敗：{ex.Message}";
        }
    }
    private async Task HandleImportAsync(InputFileChangeEventArgs args)
    {
        _message = null;
        _error = null;

        try
        {
            var count = await payoutBillService.ImportAsync(_userId, args.File);
            _message = $"成功匯入 {count} 張撥款單。";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
    

    private async Task ShowPaymentBillDetail(string paymentBillId)
    {
        var bill = await paymentBillRepo.FindByIdAsync(ObjectId.Parse(paymentBillId));
        _showPaymentBillDetail = true;
        if (bill is PaymentBill _bill)
            _selectedPaymentBill = new PaymentBillDto(_bill, _userId, 0);
    }
}
