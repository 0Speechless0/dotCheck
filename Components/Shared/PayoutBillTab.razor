@using System.Security.Claims
@using MongoDB.Bson
@inject PayoutBillService PayoutBillService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="payout-bill-panel">
    <div class="payout-bill-toolbar">
        <div>
            <h2>撥款單</h2>
            <p class="muted">顯示目前登入使用者的撥款單，可匯出或匯入簽章檔案。</p>
        </div>

        <div class="payout-bill-actions">
            <InputFile OnChange="HandleImportAsync"
                       accept="text/plain,.txt,application/json,.json" />
            <button type="button"
                    class="button primary"
                    @onclick="DownloadSelected"
                    disabled="@(_selectedIds.Count == 0 || _loading)">
                下載選取撥款單
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice success">@_message</div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="notice error">@_error</div>
    }

    @if (_loading)
    {
        <Loading />
    }
    else if (_bills.Count == 0)
    {
        <div class="notice">目前沒有可提領的撥款單。</div>
    }
    else
    {
        <div class="payout-bill-list">
            @foreach (var bill in _bills)
            {
                <article class="payout-bill-card">
                    <div class="payout-bill-check">
                        <input type="checkbox"
                               checked="@_selectedIds.Contains(ObjectId.Parse(bill.Id))"
                               @onchange="e => ToggleSelection(bill.Id, e)" />
                    </div>

                    <div class="payout-bill-main">
                        <div class="payout-bill-title-row">
                            <strong>撥款單 @bill.Id</strong>
                            <span class="status confirmed">已簽章</span>
                        </div>

                        <div class="payout-bill-grid">
                            <div>
                                <span>項目涵蓋時間</span>
                                <strong>
                                    @bill.StartDate.ToLocalTime().ToString("yyyy-MM-dd")
                                    ~
                                    @bill.EndDate.ToLocalTime().ToString("yyyy-MM-dd")
                                </strong>
                            </div>

                            <div>
                                <span>項目數</span>
                                <strong>@bill.ItemCount</strong>
                            </div>

                            <div>
                                <span>項目總金額</span>
                                <strong>@bill.ItemTotalAmount.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>可撥金額</span>
                                <strong class="money">@bill.PayoutAmount.ToString("N2")</strong>
                            </div>

                            <div>
                                <span>建立日期</span>
                                <strong>
                                    @bill.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                </strong>
                            </div>

                            <div>
                                <span>總使用者數</span>
                                <strong>@bill.TotalUserCount</strong>
                            </div>
                        </div>

                        <details class="payout-bill-signature-detail">
                            <summary>查看簽章資訊</summary>
                            <div class="payout-bill-signature-content">
                                <div>
                                    <span>Key ID</span>
                                    <code>@bill.KeyId</code>
                                </div>
                                <div>
                                    <span>Hash</span>
                                    <code>@bill.PayloadHash</code>
                                </div>
                                <div>
                                    <span>Signature</span>
                                    <textarea class="payout-code" rows="4" readonly>@bill.Signature</textarea>
                                </div>
                            </div>
                        </details>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private readonly List<PayoutBillDto> _bills = [];
    private readonly HashSet<ObjectId> _selectedIds = [];

    private ObjectId _userId;
    private bool _loading = true;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        ObjectId.TryParse(
            state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value,
            out _userId);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var bills = await PayoutBillService.GetUserPayoutBillsAsync(_userId);
            _bills.Clear();
            _bills.AddRange(bills);
            _selectedIds.RemoveWhere(id => _bills.All(x => x.Id != id.ToString()));
        }
        catch (Exception ex)
        {
            _bills.Clear();
            _selectedIds.Clear();
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleSelection(string id, ChangeEventArgs args)
    {
        if (!ObjectId.TryParse(id, out var objectId))
            return;

        if (args.Value is bool selected && selected)
            _selectedIds.Add(objectId);
        else
            _selectedIds.Remove(objectId);
    }

    private void DownloadSelected()
    {
        if (_selectedIds.Count == 0)
            return;

        var ids = Uri.EscapeDataString(string.Join(',', _selectedIds));
        NavigationManager.NavigateTo($"/payout-bills/export?ids={ids}", forceLoad: true);
    }

    private async Task HandleImportAsync(InputFileChangeEventArgs args)
    {
        _message = null;
        _error = null;

        try
        {
            var count = await PayoutBillService.ImportAsync(_userId, args.File);
            _message = $"成功匯入 {count} 張撥款單。";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
